{
  "name": "witnessed-rpg",
  "version": "0.2.0",
  "description": "Witnessed — a turn-based fantasy JRPG with a party of four, timed combat, and equipment-driven pixel heroes",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.4"
  }
}
